id: 00000000-0000-0000-0000-000000000000
name: TEMPLATE - Custom action
function: CUSTOM_ACTION
location: REPEATER
source: |+
  /**
   * TEMPLATE: Repeater custom action.
   * Side-effects only - return type is void.
   *
   * In scope: requestResponse (current editor pair), httpEditor (active editor),
   * api(), utilities(), logging().
   *
   * @author YOUR NAME
   **/

  // === BURP GLOBALS ===
  // Required:
  //   bambda-action  (boolean: "true"/"false") — master on/off switch; when false the action
  //                  exits immediately without sending any requests.
  // Optional:
  //   bambda-action-max-attempts  (int as string, default "20") — retry cap.
  // Import globals.csv via Burp Globals → Options → Import variables.
  if (!"true".equalsIgnoreCase(System.getProperty("bg.bambda-action"))) {
      return;
  }

  // === CONFIG ===
  final int MAX_ATTEMPTS = Integer.parseInt(
      java.util.Objects.requireNonNullElse(System.getProperty("bg.bambda-action-max-attempts"), "20")
  );

  var version = requestResponse.request().httpVersion().equals("HTTP/2")
      ? HttpMode.HTTP_2
      : HttpMode.HTTP_1;

  var boring = requestResponse.response().statusCode();

  for (int i = 0; i < MAX_ATTEMPTS; i++) {
      var attack = api().http().sendRequest(requestResponse.request(), version);
      if (!attack.hasResponse()) {
          logging().logToOutput("attempt " + i + ": no response");
          continue;
      }
      var status = attack.response().statusCode();
      logging().logToOutput("attempt " + i + " -> " + status);

      if (status != boring) {
          // Update the editor in place so the user sees the new response.
          httpEditor.responsePane().set(attack.response().toByteArray());
          return;
      }
  }
