id: 00000000-0000-0000-0000-000000000000
name: TEMPLATE - Custom column
function: CUSTOM_COLUMN
location: PROXY_HTTP_HISTORY
burpglobal:
  gate-column: false              # master on/off; set true to enable (bool)
source: |+
  /**
   * TEMPLATE: custom column for Proxy HTTP history.
   * Return a String - whatever you return becomes the cell text.
   *
   * NOTE: in this context `utilities` is a bare field, NOT a method.
   *
   * @author YOUR NAME
   **/

  if (!"true".equalsIgnoreCase(System.getProperty("bg.gate-column"))) {
      return "";
  }

  if (!requestResponse.hasResponse()) {
      return "";
  }

  // Example: extract the `sub` claim from a Bearer JWT.
  var auth = requestResponse.request().headerValue("Authorization");
  if (auth == null || !auth.startsWith("Bearer ")) {
      return "";
  }

  var parts = auth.substring(7).split("\\.");
  if (parts.length != 3) {
      return "";
  }

  try {
      var payload = new String(
          java.util.Base64.getUrlDecoder().decode(parts[1]),
          java.nio.charset.StandardCharsets.UTF_8
      );
      if (!utilities.jsonUtils().isValidJson(payload)) {
          return "";
      }
      return utilities.jsonUtils().readString(payload, "sub");
  } catch (Exception e) {
      return "";
  }
