id: 00000000-0000-0000-0000-000000000000
name: TEMPLATE - Active per host
function: SCAN_CHECK_ACTIVE_PER_HOST
location: SCANNER
burpglobal:
  bambda-recon: false               # master on/off; set true to enable (bool)
source: |
  /**
   * TEMPLATE: active scan check, runs once per host.
   * Probes for host-level findings independent of any base request.
   * Example: well-known files / exposed metadata.
   *
   * @author YOUR NAME
   **/

  if (!"true".equalsIgnoreCase(System.getProperty("bg.bambda-recon"))) {
      return AuditResult.auditResult();
  }

  // === CONFIG ===
  // Each entry: {path, mustContainSubstring, issueTitle, severity}
  record Probe(String path, String mustContain, String title, AuditIssueSeverity sev) {}

  var probes = java.util.List.of(
      new Probe("/.git/HEAD",       "ref: ",            "Exposed .git repository", AuditIssueSeverity.HIGH),
      new Probe("/.env",            "=",                "Exposed .env file",       AuditIssueSeverity.HIGH),
      new Probe("/server-status",   "Apache Server Status", "Exposed Apache server-status", AuditIssueSeverity.MEDIUM)
  );

  // === SETUP ===
  var svc = requestResponse.httpService();
  var scheme = svc.secure() ? "https://" : "http://";
  var origin = scheme + svc.host() + ":" + svc.port();

  var issues = new java.util.ArrayList<AuditIssue>();

  for (var p : probes) {
      var req = HttpRequest.httpRequestFromUrl(origin + p.path());
      var rr  = http.sendRequest(req);
      if (!rr.hasResponse()) continue;
      if (rr.response().statusCode() != 200) continue;

      var body = rr.response().bodyToString();
      if (body == null || !body.contains(p.mustContain())) continue;

      issues.add(AuditIssue.auditIssue(
          p.title(),
          "<p>The host serves <code>" + p.path() + "</code> with HTTP 200 and content matching the expected signature.</p>",
          "<p>Block this path at the reverse proxy, or remove the file from the document root.</p>",
          rr.request().url(),
          p.sev(),
          AuditIssueConfidence.CERTAIN,
          "",
          "",
          p.sev(),
          rr
      ));
  }

  return issues.isEmpty()
      ? AuditResult.auditResult()
      : AuditResult.auditResult(issues.toArray(new AuditIssue[0]));
