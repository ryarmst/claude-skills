id: 00000000-0000-0000-0000-000000000003
name: TEMPLATE - Regex extraction from response body
function: CUSTOM_COLUMN
location: LOGGER
burpglobal:
  column-regex-pattern: eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+   # regex (string)
  column-regex-maxlen: 80                                                    # max display length (int)
source: |+
  /**
   * Extract the first regex match from the response body.
   * Default pattern finds JWT-shaped tokens. Tune via bg.column-regex-pattern.
   * @author YOUR NAME
   **/

  if (!requestResponse.hasResponse()) {
      return "";
  }

  final var pattern = java.util.Objects.requireNonNullElse(
      System.getProperty("bg.column-regex-pattern"),
      "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+"
  );
  final int maxLen = Integer.parseInt(java.util.Objects.requireNonNullElse(
      System.getProperty("bg.column-regex-maxlen"), "80"
  ));

  var body = requestResponse.response().bodyToString();
  var m = java.util.regex.Pattern.compile(pattern).matcher(body);
  if (!m.find()) {
      return "";
  }

  var match = m.groupCount() >= 1 ? m.group(1) : m.group(0);
  return match.length() > maxLen ? match.substring(0, maxLen) + "…" : match;
